require('events', events)
require('mutable', mutable)

bus=events.new()
order=mutable.new()
mutable.set(order, 'value', [])

normal=rel(payload)
	mutable.get(order, 'value', values)
	mutable.set(order, 'value', ['normal'|values])

first=rel(payload)
	mutable.get(order, 'value', values)
	mutable.set(order, 'value', ['first'|values])

bus.on('ordered', normal, normalSubscription)
bus.onPriority('ordered', first, 10, firstSubscription)
bus.emit('ordered', {}, orderedCount)
orderedCount=2
mutable.get(order, 'value', ['normal','first'])

onceCalls=mutable.new()
mutable.set(onceCalls, 'value', 0)
ready=rel(payload)
	mutable.get(onceCalls, 'value', value)
	mutable.set(onceCalls, 'value', value+1)
bus.once('ready', ready, onceSubscription)
bus.emit('ready', {}, firstReadyCount)
bus.emit('ready', {}, secondReadyCount)
firstReadyCount=1
secondReadyCount=0
mutable.get(onceCalls, 'value', 1)
bus.off(onceSubscription, onceRemoved)
onceRemoved=0

removedCalls=mutable.new()
mutable.set(removedCalls, 'value', 0)
remover=rel(payload) bus.off(lateSubscription, removed)
late=rel(payload)
	mutable.get(removedCalls, 'value', value)
	mutable.set(removedCalls, 'value', value+1)
bus.onPriority('remove', remover, 10, removerSubscription)
bus.on('remove', late, lateSubscription)
bus.emit('remove', {}, removeCount)
removeCount=1
mutable.get(removedCalls, 'value', 0)

deferredCalls=mutable.new()
mutable.set(deferredCalls, 'value', 0)
deferred=rel(payload)
	mutable.get(deferredCalls, 'value', value)
	mutable.set(deferredCalls, 'value', value+1)
adder=rel(payload) bus.on('deferred', deferred, addedSubscription)
bus.on('deferred', adder, adderSubscription)
bus.emit('deferred', {}, firstDeferredCount)
firstDeferredCount=1
mutable.get(deferredCalls, 'value', 0)
bus.emit('deferred', {}, secondDeferredCount)
secondDeferredCount=2
mutable.get(deferredCalls, 'value', 1)

bus.listenerCount('deferred', deferredCount)
deferredCount=3
bus.clear('deferred', clearedDeferred)
clearedDeferred=3
bus.listenerCount('deferred', 0)

bus.listenerCount('ordered', orderedListeners)
orderedListeners=2
bus.clearAll(clearedAll)
clearedAll=3
bus.listenerCount('ordered', 0)
bus.listenerCount('remove', 0)

other=events.new()
other.emit('ordered', {}, otherCount)
otherCount=0

export('events tests passed')
