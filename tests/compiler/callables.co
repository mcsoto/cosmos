positive=bool(x)
    x>0
select=function(x,result)
    if(positive(x))
        result=1
    else
        result=0
select(-2,zero)
zero=0
effect=void()
    true
effect()
methods={
    function choose(x,result)
        if(positive(x))
            result=1
        else
            result=0
    bool accepts(x)
        x=1 or x=2
    void act()
        true
}
methods.choose(-1,zero)
methods.accepts(1)
methods.act()
exact=rel(Out Number value) det
    value=3
exact(three)
three=3
protocol(Producer,{
    rel produce(Out Number x) det
        x>0
})
Producer producer={rel produce(x) x=4}
producer.produce(four)
four=4
Relation In Out copy
Relation Out In copy
rel copy(a,b)
    a=b
copy(7,forward)
copy(backward,9)
forward=7
backward=9
callback=copy
callback(2,two)
two=2
rel realInput(In Real value)
    value>0
realInput(1)
rel recursive(result)
    function factorial(In Number n,Out Number value)
        if(n=0)
            value=1
        else
            factorial(n-1,previous)
            value=n*previous
    factorial(4,result)
recursive(factorialResult)
factorialResult=24
export('Callable semantics passed')
