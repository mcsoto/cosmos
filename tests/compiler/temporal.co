rel simultaneous(result)
    init x=1
    init y=2
    init i=0
    while(i<1)
        observed=next x
        next x=y
        next y=x
        x=1
        y=2
        observed=2
        choose(x=1 or y=2)
            true
        next i+=1
    result=[x,y,i]
rel branches(result)
    init i=0
    init total=0
    while(i<3)
        if(i=1)
            next total=total+10
        else
            true
        next i=i+1
    result=[i,total]
rel nested(result)
    init i=0
    init total=0
    while(i<2)
        init j=0
        while(j<3)
            next j=j+1
        next total=total+j
        next i=i+1
    result=[i,total]
rel collections(result)
    init sum=0
    for(item in [2,3,4])
        next sum+=item
    init empty=9
    for(item in [])
        next empty=item
    result=[sum,empty]
rel classic(result)
    init sum=0
    for(init i=0;i<3;next i+=1)
        next sum=sum+i
    result=[i,sum]
rel field(result)
    init ship={x=0,y=7}
    while(ship.x<3)
        old=ship.x
        next ship.x+=1
        ship.x=old
        futureX=next ship.x
        futureX=old+1
    result=[ship.x,ship.y]
rel zero(result)
    init x=5
    init unchanged=8
    while(false)
        next x=99
    unchanged=8
    result=x
rel finalConstraint(result)
    x=7
    while(false)
        next x=x+1
    result=x
simultaneous(a)
a=[2,1,1]
branches(b)
b=[3,10]
nested(c)
c=[2,6]
collections(d)
d=[9,9]
classic(e)
e=[3,3]
field(f)
f=[3,7]
zero(g)
g=5
finalConstraint(h)
h=7
export('Temporal semantics passed')
