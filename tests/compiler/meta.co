meta unless(Goal a, Goal b):binary
    if not a
        b

meta twice(Expr x):unary
    x + x

meta initialize(Goal assignment):unary
    temporal(init, assignment)

meta advance(Goal assignment):unary
    temporal(next, assignment)

meta repeatUntil(Goal body, Goal condition):binary
    temporal(until, condition, body)

rel unavailable()
    false

rel available()
    true

unavailable() unless available()
unless(unavailable(), available())

a=twice 4
b=twice(5)
a=8
b=10

initialize count=0
while(count<3)
    advance count=count+1
count=3
available() repeatUntil available()

export('Meta semantics passed')
