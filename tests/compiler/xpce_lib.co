// Headless test for the pure XPCE bridge: no window is opened, so this
// runs anywhere SWI has library(pce).  Exercises require-chain loading,
// create/send/get/free, value conversions, shared slots, timer+poll
// callback delivery, menu assembly, manual message firing (the full
// click path without a display), and the file calls the notepad uses.
require('xpce', xp)
require('io', io)

// create box + read back
xp.create('box', [80, 50], box)
xp.get(box, 'width', w)
print(['width=', w])

// move it, read position
xp.send(box, 'set', [33, 44])
xp.get(box, 'x', x)
xp.get(box, 'y', y)
print(['pos=', x, y])

// text round trip (atoms come back as strings)
xp.create('text', ['hello xpce'], t)
xp.get(t, 'string', s)
print(['text=', s])

// value constructors compose inside send args
xp.color('#ff0000', red)
xp.send(box, 'fill_pattern', [red])
xp.point(7, 9, pt)
xp.get(pt, 'x', px)
print(['point x=', px])
xp.size(640, 480, sz)
xp.get(sz, 'width', sw)
print(['size width=', sw])

// shared slots round-trip untouched values
xp.set_data('count', 41)
xp.get_data('count', n)
print(['slot=', n + 1])

// timer callback via manual pumping (no loop, no window)
xp.timer(0.01, ticked, _tm)
pump(400)

// menu assembly: popup + item + attached callback, nothing opened
xp.create('popup', ['File'], filemenu)
xp.create('menu_item', ['Save'], saveitem)
xp.on_select(saveitem, do_save_test)
xp.send(filemenu, 'append', [saveitem])

// buffer with content, shared for the save callback
xp.create('text_buffer', [], tb2)
xp.send(tb2, 'contents', ['ab\ncd'])
xp.set_data('buffer', tb2)

// fire the item's message by hand: the whole click path, synchronously
xp.get(saveitem, 'message', msg)
xp.send(msg, 'execute', [])

// the callback wrote the file; read it back through io like the app does
io.readFile('xpce_lib_check.txt', back2)
print(['fileroundtrip=', back2])

rel ticked(tm)
    print(['TICKED tm=', tm])

rel pump(n)
    if(n <= 0)
        true
    else
        xp.poll()
        pump(n - 1)

rel do_save_test(_h)
    require('xpce', xp)
    require('io', io)
    xp.get_data('buffer', tb)
    xp.get(tb, 'contents', text)
    io.writeToFile('xpce_lib_check.txt', text)
    print('SAVED-CB')
