// Executed through the self-built compiler, including actual captured values.
base=7
other=11
rel plusBase(x,y)
    y=x+base
rel makeAdder(offset,callback)
    callback=rel(x,y)
        y=x+offset
rel alternatives(x)
    x=1 or x=2
rel clauses(1)
    true
rel clauses(2)
    true
rel capturedClause(1,result)
    result=base
rel capturedClause(2,result)
    result=other
rel conditional(x,result)
    if(x=1)
        result='one'
    else
        result='other'
rel shadow(plusBase,result)
    plusBase(1,result)
rel nested(callback)
    callback=rel(x,y)
        plusBase(x,y)
rel reject()
    false
rel run()
    callback=plusBase
    callback(5,12)
    makeAdder(3,addThree)
    addThree(4,7)
    shadow(addThree,4)
    nested(indirect)
    indirect(2,9)
    captured=capturedClause
    captured(1,7)
    captured(2,11)
    conditional(1,'one')
    conditional(2,'other')
    original={x=1}
    updated=original.x:2
    original.x=1
    updated.x=2
    values=[2+3,Pair(4*2,'apostrophe: \' and slash: \\')]
    values=[5,Pair(8,_)]
    unsafeNot(reject())
export({run=run,alternatives=alternatives,clauses=clauses,reject=reject})
