// Repro 8: a relation head with a run of underscore parameters is emitted
// with the wrong arity.
//
//   cosmos -l docs/repro/underscore.co -q "t1(r)" --vars r
//   -> false
//
// The source declares five parameters.  The compiler emits four-argument
// clauses, so the wrapper u/5 passes five arguments to a four-argument
// implementation and the result parameter is dropped.  v, whose ignored
// parameters have names, is emitted correctly.

rel u([], _, _, acc, out)
    out = acc
rel u([h|t], _, _, acc, out)
    u(t, _, _, acc, out2)
    out = [h|out2]

rel v([], g0, w0, h0, acc, out)
    out = acc
rel v([h|t], g0, w0, h0, acc, out)
    v(t, g0, w0, h0, acc, out2)
    out = [h|out2]

rel t1(r)
    u([1, 2], a, b, [], r)

rel t2(r)
    v([1, 2], a, b, c, [], r)
