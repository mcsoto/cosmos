// Repro 4: `cut` is in the lowering table but does not parse.
//
//   cosmos -c repro/cut.co
//   Parse error at 29:10: Expected term
//
// `!` is not accepted as a goal, and `cut` is a reserved word, so it cannot
// be used as a relation name either:
//
//   cosmos -c repro/cut2.co
//   Parse error at 23:10: Expected goal operator
//
// The consequence is that Cosmos relations are nondeterministic with no way to
// commit, so every recursive clause needs an explicit guard.

rel cutrel(l, out)
    if(l = [])
        out = 'empty'
    else
        l = [_|t]
        out = t

rel t1(r)
    cutrel([1, 2, 3], r)
