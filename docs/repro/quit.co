// Repro 1: sp.quit() does not end the process.
//
//   cosmos -l repro/quit.co --xpce
//
// The program prints a marker and then calls sp.quit() from update.  The
// marker appears, the event loop stops, and the process stays alive with an
// orphaned window.  It has to be killed from the task manager.
//
// Expected: the process exits.  Actual: it does not.

require('space', sp)

rel update(dt, s, s2)
    if(s.n = 3)
        print('about to quit')
        sp.quit()
    s2 = {n = s.n + 1}

rel draw(s)
    g = sp.graphics
    g.clear('#101020')
    g.setColor('#40ff80')
    g.rectangle('fill', 40, 40, 120, 80)

sp.init(400, 240)
sp.start(16, {update=update and draw=draw}, {n = 0})
