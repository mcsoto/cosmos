// Repro 5: `l[i]` is a table read, not a list read.
//
//   cosmos -l repro/indexing.co -q "t1(r)" --vars r
//
// `l[2]` on a list of numbers answers 30.0 - but only because the list is
// short.  On a list of strings, and on the flat distance field the game uses,
// `l[i]` answers something else entirely.
//
// `list.at/3` and `string.at/3` are the accessors to use instead.

rel t1(r)
    l = [10, 20, 30, 40]
    r = l[2]

// The string library's own accessor does the right thing:
rel t2(r)
    row = '#.a..#'
    str.at(row, 2, ch)
    r = ch

// A hand-written index over a Cosmos list:
rel t3(r)
    l = ['x', 'y', 'z']
    at(l, 1, v)
    r = v

rel at(l, i, v)
    if(l = [])
        v = 'none'
    else
        l = [h|t]
        if(i = 0)
            v = h
        else
            i1 = i - 1
            at(t, i1, v)
