require('table', table)

nil={}

list=table.toList
update=table.update

rel new(o,prop,_o)
	table.update(o,prop,o2)
	
rel get(t,o,o2)
	choose(pl::get_(t,o,o2))
		true
	else
		//not o in t
		choose(get(t._prototype,o,o2))
			true
		else
			throw('cannot access field '+o+' of object')
	
rel set(t,o,o2,t2)
	pl::set_(t,o,o2,t2)
	
t={
	'new'=new
	'get'=get
	'set'=set
	
	rel create(o,o2)
		set(o,'_prototype',nil,o1)
		c::makeobj(o1,o2)
	
	rel createFrom(o,_o,o2)
		set(o,'_prototype',_o,o2)
	
	rel toString(o,s)
		table.remove(o,'_prototype',o2)
		table.toString(o, o2)
	
	rel _write(o,s)
		true
	
	rel map(t,l,t2)
		table.map(t,l,t2)
		
	rel imap(t,l,t2)
		table.imap(t,l,t2)
}

//set(t3,'set2',set2,t)
//export(t1)
//exports=t3
export(t)
 







t.create({x=1 and rel p(x)true;},o)
//print(o)
o.p(x)//p=o.x and p(...)