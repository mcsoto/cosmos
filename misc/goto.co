functor(Stm, Functor Any Any Any)
functor(Eq, Functor Any Any)
functor(Label, Functor Integer Stm)
functor(Variable, Functor Any)
functor(Block, Functor Any Any)
require('table',table)
//list=[Label(1,Eq(y,2))]
list1=[Label(1,[Eq(y,2),Eq(y,1)])]

rel succ(x,y)
	y=x+1 or
	y=succ(x+1)
	
rel nat(x)
	succ(0,x)
	
rel is_int(x)
	succ(-1,x)
 








	
rel push(e,e2,x)
	//e2=e[a]:b
	x=Block(a,b)
	table.set(e,a,b,e2)
	
rel run_c(c,e,e2)
	if(c=[c1|l2])
		run_c(c1,e,e1)
		run_c(l2,e1,e2)
	elseif(c=[])
		e=e2
	elseif(c=Eq(a,b))
		//e.state=[Pair(a,b)]
		//e2.state=[Block(a,b)]
		push(e,e2,Block(a,b))
	elseif(c=JMP_LE(a,b,c))
		b<c
	else
		print(c)
		throw('incorrect command')
	
rel run(c,e,e2)
	if(c=[c1|l2])
		run(c1,e,e1)//run label
		run(l2,e1,e2)
	elseif(c=[])
		e=e2
	elseif(c=Label(a,b))
		run_c(b,e,e2)
	elseif(c=Eq(a,b))
		true
	else
		print(c)
		throw('incorrect statement')
