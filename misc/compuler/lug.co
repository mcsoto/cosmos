fun custom_throw(msg, Functor info)
	if(pl::ground(info))
		info=Info(line, col)
		//logic.throw('(line '+math.integerToString(line)+', col '+math.integerToString(col)+') '+msg)
		//io.writeln(info)
		//c::throw(msg)
		throw(str('(line '+line+', col '+col+') '+msg))
	else
		throw(msg)
	
