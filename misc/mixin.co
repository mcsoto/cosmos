require('table', table)

nil={}
concat=table.concat

t={
	'new'=new
	'get'=get
	'set'=set
	
	rel mixin(o1,o2,o)
		concat(o1,o2,o)
	
	rel createFrom(o,_o,o2)
		set(o,'_prototype',_o,o2)
	
	rel toString(o,s)
		table.remove(o,'_prototype',o2)
		table.toString(o, o2)
	
	rel _write(o,s)
		true
	
	rel map(t,l,t2)
		table.map(t,l,t2)
		
	rel imap(t,l,t2)
		table.imap(t,l,t2)
}

//set(t3,'set2',set2,t)
//export(t1)
//exports=t3
export(t)
 






