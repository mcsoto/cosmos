initial={
	rel location(x,pos)
		x=somewhere
		pos=1,2 or
		x=other
		pos=2,2
	at(somewhere,1,2)
	at(other,1,2)
}

human1={
	mind={
		fact(2)
		at(1,0)
		found(food) then get(food)
		
	}+initial
	rel move(x,y)
		update(other,2,2)
}
	mind={
		fact=2
		at=pos(1,0)
		//found(food) and at(pos(1,0)) then get(food)
