rel pairs(t,l)
	init it=t.it(l)
	while(i!=0)
		t.next(it,l1,k,v,i)
		print([k,v])
		next it=l1
pairs(list,l)

rel each(k,v,t,l,p)
	init it=t.it(l)
	while(i!=0)
		t.next(it,l1,k,v,i)
		call p
		next it=l1
		
