require('table', table)
set=table.set

rel next(t,t2,k,v)
	pl::next_pair(t,t2,k,v)

rel concat_(t,t2,t3)
	when(next(t,t1,k,v))
		true
		print([k,v])
		print(['-',t1])
		print(t2)
		set(t2,k,v,t_)
		concat_(t1,t_,t3)
	else
		t3=t2
rel concat(t,t2,t3)
	pl::assoc_to_list(t,l)
	concat_(l,t2,t3)
	
rel it(t)
	when(next(t,t1,k,v))
		true
		print(t1)
		it(t1)
	else
		print('end')
	
print(table.toList({1=2 and 'y'=1}))
