// Space XPCE Backend - Native graphics API for Cosmos
// Implements the Space Canvas API using SWI-Prolog's XPCE toolkit
// Uses pl:: to call the predicates in libs/space_xpce_prolog.pl
//
// The backend talks to XPCE 10.0.0.  Two of its features matter most here:
//
//   * the keyboard INPUT DEVICE (@keyboard_device), which answers whether a
//     key is held down right now.  That is what keyboard.isDown/1 polls, so
//     the answer comes from the hardware rather than from the events, and a
//     key that was pressed while another window had the focus does not stay
//     stuck "down" for ever.
//
//   * the key RELEASE event, which XPCE delivers as an event whose id is the
//     atom key_up.  It arrives as a "keyup" in the event queue, next to the
//     "keydown" that matches it.

// Main Space API
xpce = {
    // Initialize
    rel init(width, height)
        pl::space_xpce_init(_, int(width), int(height))

    // Open the canvas.  A program that opens its own window -- the
    // startLoop shape -- calls this from inside its game relation.
    rel open()
        pl::space_xpce_open(_)

    // Start with fixed interval (ms); size comes from init/2
    rel start(intervalMs, callbacks, initialState)
        pl::space_xpce_start(_, int(intervalMs), callbacks, initialState)

    // The game-loop shape: the GAME relation opens the window and the loop
    // dispatches until it is closed.  The interval is in SECONDS here, like
    // the XPCE timer; start/3 takes milliseconds.
    rel startLoop(interval, game, callbacks, initialState)
        pl::space_xpce_start_loop_game(_, interval, game, callbacks, initialState)

    // Quit
    rel quit()
        pl::space_xpce_quit(_)

    // Dispose
    rel dispose()
        pl::space_xpce_dispose(_)

    // End the program the way quit does.  The Love2D name for it.
    rel stop()
        pl::space_xpce_stop(_)

    // Frame markers.  XPCE presents every drawing call at once, so these
    // have nothing to do.
    rel beginFrame()
        pl::space_xpce_begin_frame(_)

    rel endFrame()
        pl::space_xpce_end_frame(_)

    // Load image
    rel loadImage(source, name)
        pl::space_xpce_load_image(_, source, name)

    // Graphics, input, timer, events
    
	// Graphics module
	graphics = {
		// Background color
		rel setBackgroundColor(color)
			pl::space_xpce_set_background_color(_, color)

		rel getBackgroundColor(color)
			pl::space_xpce_get_background_color(_, color)

		// Foreground color
		rel setColor(color)
			pl::space_xpce_set_color(_, color)

		rel getColor(color)
			pl::space_xpce_get_color(_, color)

		// Clear canvas (color required; pass explicit color)
		rel clear(color)
			pl::space_xpce_clear(_, color)

		// Rectangle
		rel rectangle(mode, x, y, width, height)
			pl::space_xpce_rectangle(_, mode, int(x), int(y), int(width), int(height))

		// Line
		rel line(points)
			pl::space_xpce_line(_, points)

		// A single dot.
		rel point(x, y)
			pl::space_xpce_point(_, int(x), int(y))

		// Several dots, as one flat list of coordinates.
		rel points(points)
			pl::space_xpce_points(_, points)

		// Circle
		rel circle(mode, x, y, radius)
			pl::space_xpce_circle(_, mode, int(x), int(y), int(radius))

		// Ellipse
		rel ellipse(mode, x, y, radiusX, radiusY)
			pl::space_xpce_ellipse(_, mode, int(x), int(y), int(radiusX), int(radiusY))

		// Arc.  arcType is 'open' or 'pie'; the angles are radians.
		rel arc(mode, arcType, x, y, radius, angle1, angle2)
			pl::space_xpce_arc(_, mode, arcType, int(x), int(y), int(radius), angle1, angle2)

		// Polygon
		rel polygon(mode, points)
			pl::space_xpce_polygon(_, mode, points)

		// Text
		rel print(text, x, y)
			pl::space_xpce_print(_, text, int(x), int(y))

		// Text in a box of the given width, aligned in it ('left', 'center' or
		// 'right').
		rel printf(text, x, y, width, align)
			pl::space_xpce_printf(_, text, int(x), int(y), width, align)

		// Font handle: last param is the out value, so newFont(...) also
		// works nested in value position (e.g. setFont(newFont(...))).
		rel newFont(size, family, style, font)
			font = {size=size and family=family and style=style}

		rel setFont(font)
			pl::space_xpce_set_font(_, font.size, font.family, font.style)

		rel getFont(font)
			pl::space_xpce_get_font(_, size, family, style)
			font = {size=size and family=family and style=style}

		// Dimensions.  These are the size of the window as it actually is.
		rel getDimensions(size)
			pl::space_xpce_get_dimensions(_, width, height)
			size = {width=width and height=height}

		rel getWidth(w)
			pl::space_xpce_get_width(_, w)

		rel getHeight(h)
			pl::space_xpce_get_height(_, h)

		// Transform stack
		rel push()
			pl::space_xpce_push(_)

		rel pop()
			pl::space_xpce_pop(_)

		rel origin()
			pl::space_xpce_origin(_)

		rel translate(x, y)
			pl::space_xpce_translate(_, int(x), int(y))

		rel rotate(angle)
			pl::space_xpce_rotate(_, angle)

		rel scale(x, y)
			pl::space_xpce_scale(_, x, y)

		rel shear(x, y)
			pl::space_xpce_shear(_, x, y)

		// Line style
		rel setLineWidth(width)
			pl::space_xpce_set_line_width(_, width)

		rel getLineWidth(w)
			pl::space_xpce_get_line_width(_, w)

		rel setLineStyle(style)
			pl::space_xpce_set_line_style(_, style)

		rel getLineStyle(style)
			pl::space_xpce_get_line_style(_, style)

		// Scissor/clipping (recorded; use clearScissor() to reset)
		rel setScissor(x, y, width, height)
			pl::space_xpce_set_scissor(_, int(x), int(y), int(width), int(height))

		rel clearScissor()
			pl::space_xpce_clear_scissor(_)

		rel getScissor(scissor)
			pl::space_xpce_get_scissor(_, x, y, width, height)
			scissor = {x=x and y=y and width=width and height=height}

		// Images
		rel draw(image, x, y)
			pl::space_xpce_draw_image(_, image, int(x), int(y))

		rel refresh()
			true  // XPCE renders immediately
	}

	// Keyboard module: the key names are the lowercase Love2D ones ('left',
	// 'return', 'space', 'f1', ...).  The DOM aliases ('arrowleft', ...) are
	// accepted as well.
	//
	// The modifier keys are named the way XPCE names them: 'shift', 'ctrl',
	// 'alt' and 'gui' ('control' and 'meta' are accepted for the same keys).
	// XPCE does not deliver events for the modifier keys, so they are found
	// through the keyboard device and turned into ordinary key events; a
	// modifier therefore also shows up as a keydown/keyup event whose key is
	// 'shift', 'ctrl', 'alt' or 'gui'.
	keyboard = {
		// Succeeds while the key is held down.
		rel isDown(key)
			pl::space_xpce_keyboard_is_down(_, key, down)
			down = 1
	}

	// Mouse module
	mouse = {
		// Position of the pointer, in canvas pixels.
		rel getX(x)
			pl::space_xpce_mouse_get_position(_, x, _)

		rel getY(y)
			pl::space_xpce_mouse_get_position(_, _, y)

		rel getPosition(pos)
			pl::space_xpce_mouse_get_position(_, x, y)
			pos = {x=x and y=y}

		// Succeeds while the button is held down.  The buttons are numbered the
		// way the Space API numbers them: 1 left, 2 right, 3 middle.  The names
		// 'left', 'right' and 'middle' are accepted too.
		rel isDown(button)
			pl::space_xpce_mouse_is_down(_, button, down)
			down = 1

		// The Love2D name of the same thing.
		rel buttonDown(button)
			pl::space_xpce_mouse_is_down(_, button, down)
			down = 1
	}

	// The combined table.  Both the keyboard and the mouse are reachable here.
	input = {
		rel isDown(key)
			pl::space_xpce_keyboard_is_down(_, key, down)
			down = 1

		rel isMouseDown(button)
			pl::space_xpce_mouse_is_down(_, button, down)
			down = 1

		rel getX(x)
			pl::space_xpce_mouse_get_position(_, x, _)

		rel getY(y)
			pl::space_xpce_mouse_get_position(_, _, y)

		rel getPosition(pos)
			pl::space_xpce_mouse_get_position(_, x, y)
			pos = {x=x and y=y}

		rel buttonDown(button)
			pl::space_xpce_mouse_is_down(_, button, down)
			down = 1
	}

	// Timer module
	timer = {
		rel getTime(time)
			pl::space_xpce_get_time(_, time)

		rel getDelta(delta)
			pl::space_xpce_get_delta(_, delta)

		rel getFPS(fps)
			pl::space_xpce_get_fps(_, fps)
	}

	// get/1 drains everything XPCE has delivered since the last call and
	// hands back a list of tables, each with at least a `type` field.
	// getType/2 drains only the events of one type and leaves the rest
	// queued for the next caller.  The event types and their fields:
	//   mousemotion  posx posy x y dx dy button clicks mod
	//   mousedown    + the above
	//   mouseup      + the above
	//   mousewheel   + wheel
	//   keydown      key char mod
	//   keyup        key mod          the release of a key
	//   textinput    text             the character a key press produced
	//   focus        the window gained the keyboard focus
	//   blur         the window lost it
	//   resize       width height
	//
	// get/1 and getType/2 are separate NAMES rather than one overloaded get,
	// because the Cosmos compiler resolves a method by name, not by arity.
	//
	// The queue can also be inspected and emptied without draining it:
	//   clear()            throw every pending event away
	//   clearType(type)    throw the pending events of one type away
	//   has(type)          is there a pending event of that type?
	//   count(type)        how many pending events of that type?
	//   size()             how many pending events in all?
	event = {
		rel get(events)
			pl::space_xpce_event_get(_, events)

		rel getType(type, events)
			pl::space_xpce_event_get(_, type, events)

		// Non-draining peek, used by the frame tick to fire callbacks.
		rel peek(events)
			pl::space_xpce_events_pending(_, events)

		// Throw the pending events away without handing them over.
		rel clear()
			pl::space_xpce_event_clear(_)

		// Throw the pending events of one type away; the rest stay queued.
		rel clearType(type)
			pl::space_xpce_event_clear_type(_, type)

		// Is there a pending event of this type?  The answer is 1 or 0.
		rel has(type, found)
			pl::space_xpce_event_has(_, type, found)

		// How many pending events of this type?
		rel count(type, n)
			pl::space_xpce_event_count(_, type, n)

		// How many pending events in all?
		rel size(n)
			pl::space_xpce_event_size(_, n)
	}

}

// Export the Space table directly so `require('space', sp)`
// gives sp.init / sp.graphics / sp.start / ...

// Space - graphics API for Cosmos (native XPCE backend).
//
// The browser/JS backend is disabled for now:
//   space=js::space
//   space.canvas=js::canvas
//   export(space)
//
// Native programs use the XPCE implementation instead.
//
// This module is a forwarding layer over libs/space_xpce.co. Re-exporting the
// required module on its own does not work: `require('space_xpce', sp)` plus
// `export(sp)` leaves the interface with no members at all, because an
// `export` of a require-bound name records neither a callable nor a field
// (see compiler_issue.txt). The relations below restore the surface so
// `require('space', sp)` gives consumers the same checking as a direct
// `require('space_xpce', sp)`.
//
// Two rules keep this honest:
//   1. Signatures mirror libs/space_xpce.co exactly, including the parameter
//      that carries the result last. That last-parameter rule is what lets
//      `setFont(newFont(24,'sans','normal'))` work in value position.
//   2. No parameter is annotated here. The Space API declares no types, so
//      adding them would make this entry point stricter than space_xpce and
//      reject programs that work today. Annotate both files together, or
//      neither.
//
// A method added to space_xpce.co must be added here as well, or it stays
// invisible to anyone requiring 'space'.
//
// The rgb(...) colour functor is exported from here, so a program that
// requires 'space' can write setColor(rgb(255,0,0)) without declaring the
// functor itself.  A Cosmos functor crosses the pl:: bridge as a term
// named fc_<name>, so the backend receives fc_rgb(255,0,0) and accepts it
// wherever a colour is expected: setColor, clear and setBackgroundColor.
functor(rgb, Functor Number Number Number)

//require('space_xpce', xpce)
xpce=sp
export(xpce)
/*
// ---- Input ----
//
// The keyboard and the mouse are separate tables, so `isDown' can mean the
// keyboard under sp.keyboard and the mouse under sp.mouse.  The combined
// sp.input carries both: isDown/1 there is the keyboard, isMouseDown/1 and
// buttonDown/1 are the mouse.

rel isDown(key)
    xpce.input.isDown(key)

// ---- Timer ----

rel getTime(time)
    xpce.timer.getTime(time)

rel getDelta(delta)
    xpce.timer.getDelta(delta)

rel getFPS(fps)
    xpce.timer.getFPS(fps)

// The nested tables mirror the shape of space_xpce's own export, so consumer
// call sites are unchanged: sp.init, sp.graphics.clear, sp.keyboard.isDown.
export({
    init = init,
    start = start,
    startCanvas = startCanvas,
    quit = quit,
    dispose = dispose,
    stop = stop,
    beginFrame = beginFrame,
    endFrame = endFrame,
    loadImage = loadImage,
    graphics = {
        setBackgroundColor = setBackgroundColor,
        getBackgroundColor = getBackgroundColor,
        setColor = setColor,
        getColor = getColor,
        clear = clear,
        rectangle = rectangle,
        line = line,
        point = point,
        points = points,
        circle = circle,
        ellipse = ellipse,
        arc = arc,
        polygon = polygon,
        print = print,
        printf = printf,
        newFont = newFont,
        setFont = setFont,
        getFont = getFont,
        getDimensions = getDimensions,
        getWidth = getWidth,
        getHeight = getHeight,
        push = push,
        pop = pop,
        origin = origin,
        translate = translate,
        rotate = rotate,
        scale = scale,
        shear = shear,
        setLineWidth = setLineWidth,
        getLineWidth = getLineWidth,
        setLineStyle = setLineStyle,
        getLineStyle = getLineStyle,
        setScissor = setScissor,
        clearScissor = clearScissor,
        getScissor = getScissor,
        draw = draw,
        refresh = refresh
    },
    input = {
        isDown = isDown,
        isMouseDown = isMouseDown,
        getX = getX,
        getY = getY,
        getPosition = getPosition,
        buttonDown = buttonDown
    },
    keyboard = {
        isDown = isDown,
        getX = getX,
        getY = getY,
        getPosition = getPosition,
        buttonDown = buttonDown
    },
    mouse = {
        isDown = isMouseDown,
        getX = getX,
        getY = getY,
        getPosition = getPosition,
        buttonDown = buttonDown
    },
    timer = {
        getTime = getTime,
        getDelta = getDelta,
        getFPS = getFPS
    }
})
*/