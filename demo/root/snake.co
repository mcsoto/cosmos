require('space', sp)
require('math', math)
functor(True, Functor)
functor(False, Functor)

grid=20
cell=24
board=480
step_ms=140

// The body is a list of [x,y] cells, head first.  It grows when the snake
// eats and loses its last cell when it moves without eating.
initial={
    body=[[10,10],[9,10],[8,10]]
    food_x=14 and food_y=10
    dir_x=1 and dir_y=0
    next_x=1 and next_y=0
    score=0 and game_over=False and win=False
}

rel reset(s)
    s=initial

rel same(x1,y1,x2,y2)
    x1=x2 and y1=y2

// Build a whole state from its parts.  Keeping the field list in one
// place means tick and apply_key cannot forget a field in one branch.
rel make_state(body,food_x,food_y,dir_x,dir_y,next_x,next_y,score,game_over,win,s2)
    s2={body=body and food_x=food_x and food_y=food_y and dir_x=dir_x and dir_y=dir_y and next_x=next_x and next_y=next_y and score=score and game_over=game_over and win=win}

// Is (x,y) one of the cells in the body?  An empty list answers false.
rel hits(body,x,y)
    body=[[cx,cy]|rest]
    if(cx=x and cy=y)
        true
    else
        hits(rest,x,y)

// Drop the last cell; that is the tail the snake leaves behind when it
// moves without eating.
rel drop_last(l,l2)
    if(l=[])
        l2=[]
    else
        l=[h|t]
        if(t=[])
            l2=[]
        else
            l2=[h|r]
            drop_last(t,r)

rel place_food(body,x,y)
    math.random(1,18,x)
    math.random(1,18,y)
    when(hits(body,x,y))
        place_food(body,x,y)

rel apply_key(key,s,s2)
    if(key='up' and s.dir_y!=1)
        make_state(s.body,s.food_x,s.food_y,0,-1,0,-1,s.score,s.game_over,s.win,s2)
    elseif(key='down' and s.dir_y!=-1)
        make_state(s.body,s.food_x,s.food_y,0,1,0,1,s.score,s.game_over,s.win,s2)
    elseif(key='left' and s.dir_x!=1)
        make_state(s.body,s.food_x,s.food_y,-1,0,-1,0,s.score,s.game_over,s.win,s2)
    elseif(key='right' and s.dir_x!=-1)
        make_state(s.body,s.food_x,s.food_y,1,0,1,0,s.score,s.game_over,s.win,s2)
    elseif(key='r' and s.game_over=True)
        s2=initial
    else
        s2=s

rel tick(s,s2)
    if(s.game_over=True)
        s2=s
    else
        body=s.body
        body=[head|_]
        head=[hx,hy]
        nx=hx+s.next_x
        ny=hy+s.next_y
        if(nx<0 or nx>=grid or ny<0 or ny>=grid)
            make_state(s.body,s.food_x,s.food_y,s.next_x,s.next_y,s.next_x,s.next_y,s.score,True,False,s2)
        elseif(hits(s.body,nx,ny))
            make_state(s.body,s.food_x,s.food_y,s.next_x,s.next_y,s.next_x,s.next_y,s.score,True,False,s2)
        elseif(same(nx,ny,s.food_x,s.food_y))
            // Eat: add the new head and keep the tail, so the body grows.
            grown=[[nx,ny]|s.body]
            place_food(grown,food_x,food_y)
            make_state(grown,food_x,food_y,s.next_x,s.next_y,s.next_x,s.next_y,s.score+1,False,False,s2)
        else
            // Move: add the new head and drop the last cell.
            grown=[[nx,ny]|s.body]
            drop_last(grown,shrunk)
            make_state(shrunk,s.food_x,s.food_y,s.next_x,s.next_y,s.next_x,s.next_y,s.score,False,False,s2)

// The XPCE backend has no `keypressed` callback name: input is polled from
// the event queue inside update, and apply_key is fed from it, one key at a
// time, threading the state through the keys.
//
// The queue is taken in one go and sorted out here.  getType/2 would keep
// the events it was not asked for, and this demo never looks at them, so
// they would pile up for ever.
rel update(s,s2)
    sp.event.get(events)
    apply_events(events,s,s1)
    tick(s1,s2)

// Apply every event of this frame to the running state.
rel apply_events(events,s,s2)
    if(events=[])
        s2=s
    else
        events=[ev|rest]
        kind=ev.type
        if(kind='keydown')
            apply_key(ev.key,s,s1)
        else
            s1=s
        apply_events(rest,s1,s2)

rel draw_cell(x,y,color)
    sp.graphics.setColor(color)
    sp.graphics.rectangle('fill',x*cell+1,y*cell+1,cell-2,cell-2)

rel draw_body(body)
    if(body=[])
        true
    else
        body=[c|rest]
        c=[x,y]
        draw_cell(x,y,'#42d99a')
        draw_body(rest)

rel render(s)
    sp.graphics.setColor('#0b1220')
    sp.graphics.rectangle('fill',0,0,board,board)
    draw_cell(s.food_x,s.food_y,'#ff6b6b')
    draw_body(s.body)
    body=s.body
    body=[head|_]
    head=[hx,hy]
    draw_cell(hx,hy,'#b4ffe2')
    if(s.game_over=True)
        sp.graphics.setColor('#182235')
        sp.graphics.rectangle('fill',90,200,300,80)
        sp.graphics.setColor('#f3c969')
        sp.graphics.printf('GAME OVER',90,214,300,'center')
        sp.graphics.setColor('#9bb7c6')
        sp.graphics.printf('press R to restart',90,246,300,'center')

sp.init(board,board)
sp.start(step_ms,{
    update=update and draw=render
},initial)

require('xpce', xp)

xp.main_loop(game)
